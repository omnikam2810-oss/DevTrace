generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  ENGINEERING_MANAGER
  DEVELOPER
  VIEWER
}

enum Environment {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum ServiceStatus {
  HEALTHY
  WARNING
  DEGRADED
  CRITICAL
  OFFLINE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum SpanStatus {
  OK
  ERROR
  TIMEOUT
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertState {
  TRIGGERED
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum IncidentState {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  passwordHash   String
  role           Role             @default(DEVELOPER)
  memberships    Membership[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  projects    Project[]
  members     Membership[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id             String        @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  services       Service[]
  alertRules     AlertRule[]
  incidents      Incident[]
  reports        Report[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, slug])
}

model Service {
  id              String                 @id @default(uuid())
  projectId       String
  name            String
  description     String?
  version         String?
  owner           String?
  status          ServiceStatus          @default(OFFLINE)
  environment     Environment
  repositoryUrl   String?
  deploymentInfo  Json?
  lastSeenAt      DateTime?
  healthScore     Int                    @default(0)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics         ServiceMetric[]
  logs            LogEvent[]
  spans           Span[]
  deployments     Deployment[]
  dependenciesOut ServiceDependency[]    @relation("DependencySource")
  dependenciesIn  ServiceDependency[]    @relation("DependencyTarget")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([projectId, name, environment])
  @@index([projectId, status])
  @@index([lastSeenAt])
}

model ServiceMetric {
  id             String   @id @default(uuid())
  serviceId      String
  timestamp      DateTime @default(now())
  cpuPercent     Float?
  memoryPercent  Float?
  diskPercent    Float?
  networkRxBytes BigInt?
  networkTxBytes BigInt?
  requestCount   Int      @default(0)
  errorCount     Int      @default(0)
  avgLatencyMs   Float?
  p50LatencyMs   Float?
  p95LatencyMs   Float?
  p99LatencyMs   Float?
  throughputRpm  Float?
  statusCodes    Json?
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
  @@index([timestamp])
}

model LogEvent {
  id          String    @id @default(uuid())
  serviceId   String
  traceId     String?
  spanId      String?
  timestamp   DateTime  @default(now())
  level       LogLevel
  message     String
  attributes  Json?
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, timestamp])
  @@index([level, timestamp])
  @@index([traceId])
}

model Trace {
  id          String   @id
  projectId   String
  rootService String?
  startedAt   DateTime
  durationMs  Float
  status      SpanStatus @default(OK)
  spans       Span[]

  @@index([projectId, startedAt])
  @@index([status, startedAt])
}

model Span {
  id          String     @id
  traceId     String
  parentSpanId String?
  serviceId   String
  name        String
  kind        String?
  startedAt   DateTime
  durationMs  Float
  status      SpanStatus @default(OK)
  attributes  Json?
  trace       Trace      @relation(fields: [traceId], references: [id], onDelete: Cascade)
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([traceId, parentSpanId])
  @@index([serviceId, startedAt])
}

model AlertRule {
  id          String        @id @default(uuid())
  projectId   String
  name        String
  metric      String
  operator    String
  threshold   Float
  windowSec   Int
  severity    AlertSeverity
  enabled     Boolean       @default(true)
  channels    Json?
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alerts      Alert[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, enabled])
}

model Alert {
  id          String      @id @default(uuid())
  ruleId      String?
  serviceId   String?
  title       String
  description String
  severity    AlertSeverity
  state       AlertState  @default(TRIGGERED)
  triggeredAt DateTime    @default(now())
  resolvedAt  DateTime?
  metadata    Json?
  rule        AlertRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  incidentId  String?
  incident    Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([serviceId, state])
  @@index([triggeredAt])
}

model Incident {
  id              String        @id @default(uuid())
  projectId       String
  title           String
  description     String
  severity        AlertSeverity
  state           IncidentState @default(OPEN)
  rootCause       String?
  impactedServices Json?
  resolutionNotes String?
  timeline        Json
  aiSummary       String?
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alerts          Alert[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId, state])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  body        String
  channel     String
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  organizationId String
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model Deployment {
  id          String   @id @default(uuid())
  serviceId   String
  version     String
  commitSha   String?
  environment Environment
  deployedBy  String?
  metadata    Json?
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([serviceId, createdAt])
}

model ServiceDependency {
  id              String   @id @default(uuid())
  sourceServiceId String
  targetServiceId String
  protocol        String?
  endpoint        String?
  callCount       Int      @default(0)
  errorRate       Float    @default(0)
  avgLatencyMs    Float?
  lastSeenAt      DateTime @default(now())
  source          Service  @relation("DependencySource", fields: [sourceServiceId], references: [id], onDelete: Cascade)
  target          Service  @relation("DependencyTarget", fields: [targetServiceId], references: [id], onDelete: Cascade)

  @@unique([sourceServiceId, targetServiceId, endpoint])
  @@index([targetServiceId])
}

model ApiKey {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  keyHash        String
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, revokedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  projectId   String
  period      String
  title       String
  format      String
  storageUrl  String?
  summary     Json
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectId, period, createdAt])
}

